rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isApprovedConnection(familyUid, patientUid) {
      return exists(
            /databases/$(database)/documents/connections/$(familyUid + '_' + patientUid)
          ) &&
          get(
            /databases/$(database)/documents/connections/$(familyUid + '_' + patientUid)
          ).data.status == 'approved';
    }

    function hasConnectionForPatient(patientUid, familyUid) {
      return exists(
        /databases/$(database)/documents/connections/$(familyUid + '_' + patientUid)
      );
    }

    function canGrantFamilyRole(familyUid) {
      let oldRoles = resource.data.roles is map ? resource.data.roles : {};
      let newRoles = request.resource.data.roles is map ? request.resource.data.roles : {};
      return request.auth != null &&
          request.auth.uid != familyUid &&
          hasConnectionForPatient(request.auth.uid, familyUid) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['roles', 'updatedAt']) &&
          newRoles.family_member == true &&
          oldRoles.family_member != true &&
          newRoles.diff(oldRoles).changedKeys().hasOnly(['family_member']);
    }

    match /users/{uid} {
      // Allow authenticated users to read/write their own profile
      allow read: if request.auth != null &&
          (request.auth.uid == uid ||
           isApprovedConnection(request.auth.uid, uid) ||
           hasConnectionForPatient(request.auth.uid, uid));
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null &&
          (request.auth.uid == uid || canGrantFamilyRole(uid));
    }
    match /users/{uid}/medicines/{medicineId} {
      allow read: if request.auth != null &&
          (request.auth.uid == uid ||
           isApprovedConnection(request.auth.uid, uid));
      allow create, update, delete: if request.auth != null &&
          request.auth.uid == uid;
    }
    match /patients/{uid} {
      allow get: if request.auth != null &&
          (request.auth.uid == uid ||
           isApprovedConnection(request.auth.uid, uid));
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null &&
          request.auth.uid == uid &&
          request.resource.data.publicId == resource.data.publicId;
      allow delete, list: if false;
    }
    match /patientPublicIds/{publicId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null &&
          request.resource.data.uid == request.auth.uid &&
          !exists(/databases/$(database)/documents/patientPublicIds/$(publicId));
      allow update, delete, list: if false;
    }
    match /connections/{connectionId} {
      allow get: if request.auth != null &&
          (request.auth.uid == resource.data.familyMemberUid ||
           request.auth.uid == resource.data.patientUid);
      allow list: if request.auth != null &&
          (request.query.where('familyMemberUid', '==', request.auth.uid) ||
           request.query.where('patientUid', '==', request.auth.uid));
      allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.familyMemberUid &&
          request.resource.data.status == 'pending';
      allow update: if request.auth != null &&
          request.auth.uid == resource.data.patientUid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'approved' &&
          request.resource.data.familyMemberUid == resource.data.familyMemberUid &&
          request.resource.data.patientUid == resource.data.patientUid &&
          request.resource.data.relation == resource.data.relation;
      allow delete: if request.auth != null &&
          request.auth.uid == resource.data.patientUid;
    }
    match /medicineRequests/{requestId} {
      allow get: if request.auth != null &&
          (request.auth.uid == resource.data.patientUid ||
           request.auth.uid == resource.data.familyMemberUid);
      allow list: if request.auth != null &&
          (request.query.where('familyMemberUid', '==', request.auth.uid) ||
           request.query.where('patientUid', '==', request.auth.uid));
      allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.familyMemberUid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.type == 'add' &&
          isApprovedConnection(request.auth.uid, request.resource.data.patientUid);
      allow update: if request.auth != null &&
          request.auth.uid == resource.data.patientUid &&
          resource.data.status == 'pending' &&
          (request.resource.data.status == 'approved' ||
           request.resource.data.status == 'rejected') &&
          request.resource.data.familyMemberUid == resource.data.familyMemberUid &&
          request.resource.data.patientUid == resource.data.patientUid &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.medicine == resource.data.medicine;
      allow delete: if request.auth != null &&
          request.auth.uid == resource.data.patientUid;
    }
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
